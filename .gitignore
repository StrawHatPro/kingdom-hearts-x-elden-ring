/assets/
/assets_converted/
/audit/
# the asset pack, generated code and every other build output
/build/
/target/
# sheets regenerated from your own KH3 install (only sheets/port is part of the repository)
/sheets/*
!/sheets/port/
# machine-specific
/tools/config.json
/tools/third_party/ogg-vorbis-decoder/ogg-vorbis-decoder.min.js
/node_modules/
# your own files
/user/

# ---- The mod folder: only the profile and the launcher are part of the repository ----
/er/*
!/er/profiles/
!/er/play.bat
!/er/play.sh
/er/profiles/*
!/er/profiles/kh-sora.me3

